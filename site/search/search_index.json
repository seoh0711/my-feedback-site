{"config":{"lang":["ko","en"],"separator":"[\\s\\-]+","pipeline":[" "]},"docs":[{"location":"","title":"\ud658\uc601\ud569\ub2c8\ub2e4","text":"<p>\uc774 \uc0ac\uc774\ud2b8\ub294 \ub3c5\uc790\uac00 \ubb38\ub2e8\ubcc4\ub85c \ud53c\ub4dc\ubc31\uc744 \ub0a8\uae38 \uc218 \uc788\ub294 \ud14d\uc2a4\ud2b8 \ucf58\ud150\uce20 \uc0ac\uc774\ud2b8\uc785\ub2c8\ub2e4. \uae00\uc744 \uc77d\ub2e4\uac00 \ub9c8\uc74c\uc5d0 \ub4dc\ub294 \ubb38\uc7a5, \uac38\uc6b0\ub6b1\ud55c \ubb38\ub2e8, \ud639\uc740 \ub354 \ub4e3\uace0 \uc2f6\uc740 \uc774\uc57c\uae30\uac00 \uc788\ub2e4\uba74 \uadf8 \uc790\ub9ac\uc5d0 \ubc14\ub85c \uba54\ubaa8\ub97c \ub0a8\uaca8 \ubcf4\uc138\uc694. \uac00\uc785\uc774\ub098 \ubc88\uac70\ub85c\uc6b4 \uc808\ucc28 \uc5c6\uc774, \ub204\uad6c\ub098 \uac00\ubccd\uac8c \uc758\uacac\uc744 \ubcf4\ud0e4 \uc218 \uc788\ub3c4\ub85d \ub9cc\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4.</p>"},{"location":"#_2","title":"\ubb34\uc5c7\uc774 \uc788\ub098\uc694","text":"<ul> <li>\uae00: \uc2dc\uac04\uc21c\uc73c\ub85c \uc313\uc774\ub294 \uae00\ub4e4\uc744 \ubaa8\uc544 \ub454 \uacf5\uac04\uc785\ub2c8\ub2e4. \uc9e7\uc740 \ub2e8\uc0c1\ubd80\ud130 \uae38\uac8c \ud480\uc5b4\uc4f4 \uc774\uc57c\uae30\uae4c\uc9c0 \ud568\uaed8 \uc62c\ub77c\uc635\ub2c8\ub2e4.</li> <li>\uc18c\uac1c: \uae00\uc744 \uc4f0\ub294 \uc0ac\ub78c\uacfc \uc774 \uc5f0\uc7ac\uac00 \uc5b4\ub5a4 \uacb0\uc744 \uac00\uc84c\ub294\uc9c0 \uc9e7\uac8c \uc801\uc5b4 \ub450\uc5c8\uc2b5\ub2c8\ub2e4.</li> <li>\ud53c\ub4dc\ubc31 \uc548\ub0b4: \uc5b4\ub5bb\uac8c \uba54\ubaa8\ub97c \ub0a8\uae30\ub294\uc9c0, \uc5b4\ub5a4 \ubd84\uc704\uae30\ub85c \ub300\ud654\uac00 \uc624\uac00\uba74 \uc88b\uc744\uc9c0 \uc548\ub0b4\ud569\ub2c8\ub2e4.</li> </ul>"},{"location":"#_3","title":"\ucd5c\uadfc \uae00","text":"<ul> <li>\ud658\uc601\ud569\ub2c8\ub2e4 \u2014 \uc0ac\uc774\ud2b8\ub97c \uc5f4\uba70 \uc801\uc740 \uccab \uae00</li> <li>\ud53c\ub4dc\ubc31 \uc0ac\uc6a9\ubc95 \u2014 \ubcf8\ubb38\uc5d0 \uc9c1\uc811 \uba54\ubaa8\ub97c \ub0a8\uae30\ub294 \uac00\ubcbc\uc6b4 \uc18c\uac1c</li> </ul> <p>\uc804\uccb4 \ubaa9\ub85d\uc740 \uae00 \ud398\uc774\uc9c0\uc5d0\uc11c \ud55c\ub208\uc5d0 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"#_4","title":"\uc5b4\ub5bb\uac8c \uc77d\uc73c\uba74 \uc88b\uc744\uae4c\uc694","text":"<p>\uc11c\ub450\ub974\uc9c0 \ub9c8\uc138\uc694. \ud55c \ubb38\ub2e8\uc5d0 \uba38\ubb3c\ub7ec\ub3c4 \uc88b\uace0, \ube60\ub974\uac8c \ud6d1\uc5b4\ub3c4 \uc88b\uc2b5\ub2c8\ub2e4. \ubb38\ub2e8 \ub05d\uc758 \uc791\uc740 \ud45c\uc2dc\ub97c \ub20c\ub7ec \uc758\uacac\uc744 \ub0a8\uae30\uba74, \uadf8 \uc790\ub9ac\uc5d0 \uadf8\ub300\ub85c \uba54\ubaa8\uac00 \ubd99\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \ub3c5\uc790\uc758 \uba54\ubaa8\ub3c4 \ud568\uaed8 \ubcfc \uc218 \uc788\uc73c\ub2c8, \uac19\uc740 \ubb38\uc7a5\uc5d0\uc11c \uc0ac\ub78c\ub4e4\uc774 \uc5b4\ub5a4 \uc0dd\uac01\uc744 \ud588\ub294\uc9c0 \uc0b4\ud3b4\ubcf4\ub294 \uc7ac\ubbf8\ub3c4 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"about/","title":"\uc18c\uac1c","text":"<p>\uc5ec\uae30\ub97c \ucc44\uc6cc\uc8fc\uc138\uc694.</p> <p>\uc800\uc790\uc640 \uc5f0\uc7ac\uc758 \ubd84\uc704\uae30\ub97c \uc9e7\uac8c \uc18c\uac1c\ud558\ub294 \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \uc5b4\ub5a4 \uc774\uc57c\uae30\ub97c \uc5b4\ub5a4 \uacb0\ub85c \ud480\uc5b4\uac00\ub294\uc9c0, \ub204\uac00 \uc4f0\uace0 \uc788\ub294\uc9c0\ub97c \uac00\ubccd\uac8c \uc801\uc5b4 \ub450\uba74 \ub3c5\uc790\uac00 \uae00\uc5d0 \ub2e4\uac00\uac00\uae30 \uc26c\uc6cc\uc9d1\ub2c8\ub2e4.</p>"},{"location":"about/#_2","title":"\uc791\uc131 \uac00\uc774\ub4dc (\ud55c \uc904)","text":"<p>\uc774 \ud398\uc774\uc9c0\ub294 \ub9c8\ud06c\ub2e4\uc6b4\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4. \uc81c\ubaa9\uc740 <code>#</code> \ub450 \uac1c\ub85c \uc2dc\uc791\ud558\ub294 <code>##</code> \ubd80\ud130 \ubcf8\ubb38 \uc548\uc5d0 \uc790\uc720\ub86d\uac8c \uc4f0\uc154\ub3c4 \ub429\ub2c8\ub2e4. \uad75\uac8c\ub294 <code>**\uad75\uac8c**</code>, \uc778\uc6a9\uc740 <code>&gt; \uc778\uc6a9</code> \ucc98\ub7fc \ud45c\ud604\ud569\ub2c8\ub2e4.</p>"},{"location":"about/#_3","title":"\uc608\uc2dc \uc139\uc158","text":"<ul> <li>\uc800\uc790: (\uc774\ub984 / \uc9e7\uc740 \uc18c\uac1c)</li> <li>\uc5f0\uc7ac \uc8fc\uae30: (\uc608: \ub9e4\uc8fc \ud654\uc694\uc77c)</li> <li>\uc5f0\ub77d\ucc98: (\uc774\uba54\uc77c / SNS \ub4f1)</li> <li>\uc774 \uc5f0\uc7ac\uac00 \ub2e4\ub8e8\ub294 \uc8fc\uc81c: (\ud55c\ub450 \uc904)</li> </ul> <p>\uc704 \ud56d\ubaa9\ub4e4\uc740 \uc790\uc720\ub86d\uac8c \ubc14\uafb8\uac70\ub098 \uc9c0\uc6cc\ub3c4 \ub429\ub2c8\ub2e4. \uc0ac\uc774\ud2b8 \uc804\uccb4\uc758 \ud1a4\uc740 \uce90\uc8fc\uc5bc\ud55c \ube14\ub85c\uadf8/\ub274\uc2a4\ub808\ud130\uc5d0 \uac00\uae4c\uc6b0\ub2c8, \ub108\ubb34 \uaca9\uc2dd \ucc28\ub9ac\uc9c0 \uc54a\uc544\ub3c4 \uad1c\ucc2e\uc2b5\ub2c8\ub2e4.</p>"},{"location":"contribute/","title":"\ud53c\ub4dc\ubc31 \uc548\ub0b4","text":"<p>\uc774 \uc0ac\uc774\ud2b8\uc758 \ubaa8\ub4e0 \uae00\uc5d0\ub294 \ubb38\ub2e8 \ub2e8\uc704\ub85c \uc758\uacac\uc744 \ub0a8\uae38 \uc218 \uc788\ub294 \uba54\ubaa8 \uae30\ub2a5\uc774 \ubd99\uc5b4 \uc788\uc5b4\uc694. \ucc45\uc5d0 \ud3ec\uc2a4\ud2b8\uc787\uc744 \ubd99\uc774\ub4ef, \ub9c8\uc74c\uc5d0 \uac78\ub9ac\ub294 \ubb38\uc7a5 \uc704\uc5d0 \uc9e7\uc740 \ud55c \uc904\uc744 \uc5b9\uc5b4 \uc8fc\uc138\uc694. \uc774 \ud398\uc774\uc9c0\ub294 \uadf8 \uc0ac\uc6a9\ubc95\uc744 \uce90\uc8fc\uc5bc\ud558\uac8c \ubaa8\uc544 \ub454 \uc548\ub0b4\ubb38\uc785\ub2c8\ub2e4.</p>"},{"location":"contribute/#_2","title":"\ud55c\ub208\uc5d0 \ubcf4\uae30","text":"<ul> <li>\uc758\uacac\uc744 \ub0a8\uae30\ub824\uba74 \ubcf8\ubb38\uc5d0\uc11c \ubb38\uc7a5\uc774\ub098 \ubb38\ub2e8\uc744 \ub9c8\uc6b0\uc2a4\ub85c \ub4dc\ub798\uadf8\ud558\uc138\uc694.</li> <li>\uc791\uc740 \ub3c4\uad6c\ucc3d\uc774 \ub728\uba74 Annotate(\uba54\ubaa8)\ub098 Highlight(\ub098\ub9cc\uc758 \ud615\uad11\ud39c)\ub97c \uace0\ub974\uba74 \ub429\ub2c8\ub2e4.</li> <li>\ucc98\uc74c \ud55c \ubc88\uc740 hypothes.is \uacc4\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4 (\uc774\uba54\uc77c \ub610\ub294 Google \ub85c\uadf8\uc778, \uc57d 30\ucd08).</li> </ul>"},{"location":"contribute/#1","title":"1. \uc0ac\uc774\ub4dc\ubc14 \uc5f4\uae30","text":"<p>\ud654\uba74 \uc624\ub978\ucabd \uc704\uc758 \uc791\uc740 \ud654\uc0b4\ud45c \ubc84\ud2bc(<code>&lt;</code>)\uc744 \ud074\ub9ad\ud558\uba74 Hypothesis \uc0ac\uc774\ub4dc\ubc14\uac00 \uc5f4\ub9bd\ub2c8\ub2e4. \uac19\uc740 \ud398\uc774\uc9c0\ub97c \uc77d\uace0 \uc788\ub294 \ub2e4\ub978 \ub3c5\uc790\uc758 \uba54\ubaa8\ub3c4 \uc5ec\uae30\uc11c \ud568\uaed8 \ubcfc \uc218 \uc788\uc5b4\uc694. \ucc98\uc74c \ub4e4\uc5b4\uc624\uba74 \ud654\uc0b4\ud45c\ub294 \uc0b4\uc9dd \uc228\uc5b4 \uc788\uc744 \uc218 \uc788\ub294\ub370, \uac00\ub9cc\ud788 \ub450\uba74 \uace7 \ub098\ud0c0\ub0a9\ub2c8\ub2e4.</p>"},{"location":"contribute/#2","title":"2. \uba54\ubaa8 \ub0a8\uae30\ub294 \ubc95","text":"<ol> <li>\ubcf8\ubb38\uc5d0\uc11c \ub9c8\uc74c\uc5d0 \uac78\ub9ac\ub294 \ubb38\uc7a5 \ub610\ub294 \ubb38\ub2e8\uc744 \ub4dc\ub798\uadf8\ud558\uc138\uc694.</li> <li>\ub5a0\uc624\ub974\ub294 \uc791\uc740 \ub3c4\uad6c\ucc3d\uc5d0\uc11c \ub450 \uac00\uc9c0 \uc911 \ud558\ub098\ub97c \uace0\ub97c \uc218 \uc788\uc5b4\uc694.<ul> <li>Annotate \u2014 \uba54\ubaa8\ub97c \ub0a8\uae30\uace0 \ub2e4\ub978 \ub3c5\uc790\uc640 \uacf5\uc720\ud569\ub2c8\ub2e4.</li> <li>Highlight \u2014 \ud615\uad11\ud39c\ucc98\ub7fc \ud45c\uc2dc\ub9cc \ud574 \ub450\ub294 \ub098\ub9cc\uc758 \ud754\uc801\uc774\uc5d0\uc694.</li> </ul> </li> <li>\uba54\ubaa8 \ub0b4\uc6a9\uc744 \uc801\uace0 Post\ub97c \ub204\ub974\uba74 \ub05d\uc785\ub2c8\ub2e4.</li> <li>\ub2e4\ub978 \uc0ac\ub78c\uc758 \uba54\ubaa8\uc5d0 \ub2f5\uae00\uc744 \ub2ec\ub824\uba74 \uba54\ubaa8 \uc6b0\uce21 \ud558\ub2e8\uc758 Reply\ub97c \ub20c\ub7ec \uc8fc\uc138\uc694.</li> </ol>"},{"location":"contribute/#3","title":"3. \uacf5\uac1c \ubc94\uc704","text":"<p>\uae30\ubcf8 \uc124\uc815\uc740 \uc804\uccb4 \uacf5\uac1c\uc785\ub2c8\ub2e4. \ub2e4\ub978 \ub3c5\uc790\uc640 \uc800\uc790\uac00 \ubaa8\ub450 \uba54\ubaa8\ub97c \ubcfc \uc218 \uc788\uc5b4\uc694. \ubcf8\uc778\ub9cc \ubcf4\uace0 \uc2f6\uc740 \uba54\ubaa8\ub294 \uc791\uc131 \ud654\uba74\uc5d0\uc11c \uc6b0\uce21 \uc0c1\ub2e8\uc758 \uadf8\ub8f9 \uc120\ud0dd\uc744 Only Me\ub85c \ubc14\uafb8\uba74 \ub429\ub2c8\ub2e4.</p> <p>\ud55c \uac00\uc9c0\ub9cc \uae30\uc5b5\ud574 \uc8fc\uc138\uc694</p> <p>Hypothesis\ub294 \ud398\uc774\uc9c0\uc758 \ud14d\uc2a4\ud2b8\uc640 \uad6c\uc870\ub97c \uae30\uc900\uc73c\ub85c \uba54\ubaa8\ub97c \ubd99\uc785\ub2c8\ub2e4. \ubb38\ub2e8\uc774 \ud06c\uac8c \ub2e4\uc2dc \uc4f0\uc774\uba74, \uae30\uc874 \uba54\ubaa8\uac00 \"\uc6d0\ub798 \uc790\ub9ac\"\ub97c \ucc3e\uc9c0 \ubabb\ud558\uace0 \ub5a0\ub3c4\ub294 \uc0c1\ud0dc(orphan)\uac00 \ub420 \uc218 \uc788\uc5b4\uc694. \uc800\uc790\ub3c4 \uc774\ub97c \uc5fc\ub450\uc5d0 \ub450\uace0 \ubcf8\ubb38\uc744 \uc190\ubcfc \uc608\uc815\uc785\ub2c8\ub2e4.</p>"},{"location":"contribute/#4","title":"4. \uacc4\uc815\uacfc \uc775\uba85\uc131","text":"<ul> <li>Hypothesis \uacc4\uc815\uc740 \ub2c9\ub124\uc784\ub9cc \uacf5\uac1c\ub418\ubbc0\ub85c, \ub2c9\ub124\uc784\uc744 \ubcf8\uba85\uc774 \uc544\ub2cc \uac83\uc73c\ub85c \uc815\ud558\uba74 \uc0ac\uc2e4\uc0c1 \uc775\uba85\uc5d0 \uac00\uae5d\uac8c \ud65c\ub3d9\ud560 \uc218 \uc788\uc5b4\uc694.</li> <li>\ub2e4\ub9cc \uc644\uc804\ud55c \uc775\uba85\uc740 \ubcf4\uc7a5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uba54\ubaa8\uc640 \uacc4\uc815\uc740 hypothes.is \uc11c\ubc84(\ubbf8\uad6d \uc18c\uc7ac)\uc5d0 \uc800\uc7a5\ub429\ub2c8\ub2e4.</li> <li>\uac00\uc785 \uc790\uccb4\uac00 \ubd80\ub2f4\uc2a4\ub7ec\uc6b0\uba74, \ud398\uc774\uc9c0 \ud558\ub2e8\uc758 \uc774\uba54\uc77c/\uc774\uc288 \ud2b8\ub798\ucee4\ub97c \ud1b5\ud574 \uc0ac\uc801\uc73c\ub85c \uc758\uacac\uc744 \ubcf4\ub0b4 \uc8fc\uc154\ub3c4 \uc88b\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"contribute/#5","title":"5. \ubd84\uc704\uae30\uc5d0 \ub300\ud55c \ubd80\ud0c1","text":"<p>\uac19\uc740 \ubb38\ub2e8\uc744 \ud568\uaed8 \uc77d\uace0 \uc788\ub294 \ub2e4\ub978 \ub3c5\uc790\uac00 \uc788\ub2e4\uace0 \uc0c1\uc0c1\ud558\uba74\uc11c, \ud55c \ud638\ud761 \uace8\ub77c \uc801\uc5b4 \uc8fc\uc2dc\uba74 \uc88b\uaca0\uc5b4\uc694. \uba87 \uac00\uc9c0\ub9cc \ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4.</p> <ul> <li>\uc2a4\ud3ec\uc77c\ub7ec \uae08\uc9c0 \u2014 \uac19\uc740 \uae00\uc758 \ub4b7\ubd80\ubd84\uc774\ub098 \ub2e4\ub978 \uae00\uc758 \uacb0\uc815\uc801 \uc7a5\uba74\uc740 \uac00\uae09\uc801 \uac00\ub824 \uc8fc\uc138\uc694.</li> <li>\uc778\uc2e0\uacf5\uaca9 \uae08\uc9c0 \u2014 \uae00\uc774\ub098 \uc758\uacac\uc740 \uc5bc\ub9c8\ub4e0\uc9c0 \ubc18\ubc15\ud574\ub3c4 \uc88b\uc9c0\ub9cc, \uc0ac\ub78c\uc744 \ud5a5\ud55c \ucf54\uba58\ud2b8\ub294 \ud53c\ud574 \uc8fc\uc138\uc694.</li> <li>\uc800\uc791\uad8c \uc874\uc911 \u2014 \uae34 \uc678\ubd80 \uc778\uc6a9\uc740 \ucd9c\ucc98\ub97c \uac19\uc774 \uc801\uc5b4 \uc8fc\uc138\uc694.</li> <li>\uad11\uace0/\uc2a4\ud338 \uae08\uc9c0 \u2014 \ubc1c\uacac \uc2dc \uba54\ubaa8\ub294 \ube44\uacf5\uac1c \ucc98\ub9ac\ub429\ub2c8\ub2e4.</li> </ul>"},{"location":"contribute/#6","title":"6. \uc790\uc8fc \ubb3b\ub294 \uac83","text":"<p>Q. \uc0ac\uc774\ub4dc\ubc14\uac00 \uc548 \ubcf4\uc5ec\uc694. \ube0c\ub77c\uc6b0\uc800\uc758 \uad11\uace0 \ucc28\ub2e8\uae30(uBlock Origin \ub4f1)\uac00 <code>hypothes.is</code> \ub3c4\uba54\uc778\uc744 \ub9c9\uace0 \uc788\uc744 \uac00\ub2a5\uc131\uc774 \ud07d\ub2c8\ub2e4. \uc774 \uc0ac\uc774\ud2b8\uc5d0\uc11c\ub9cc \ucc28\ub2e8\uc744 \ud480\uc5b4 \uc8fc\uc138\uc694.</p> <p>Q. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub3c4 \ub418\ub098\uc694? \ub429\ub2c8\ub2e4. \ub2e4\ub9cc \ud654\uba74\uc774 \uc881\uc544 \uc0ac\uc774\ub4dc\ubc14 \uc0ac\uc6a9\uc774 \ub2e4\uc18c \ub2f5\ub2f5\ud560 \uc218 \uc788\uc5b4\uc694. \uac00\ub2a5\ud558\uba74 \ub370\uc2a4\ud06c\ud1b1 \ube0c\ub77c\uc6b0\uc800\ub97c \uad8c\uc7a5\ud569\ub2c8\ub2e4.</p> <p>Q. \uba54\ubaa8\ub97c \uc0ad\uc81c\ud558\uace0 \uc2f6\uc5b4\uc694. \ubcf8\uc778\uc774 \uc791\uc131\ud55c \uba54\ubaa8\ub294 \uba54\ubaa8 \uc6b0\uce21 \ud558\ub2e8\uc758 \u22ee \uba54\ub274\uc5d0\uc11c \uc5b8\uc81c\ub4e0 \uc0ad\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p> <p>\uc77d\uc5b4 \uc8fc\uc154\uc11c \uace0\ub9d9\uc2b5\ub2c8\ub2e4. \uc5b4\ub5a4 \uacb0\uc758 \ucf54\uba58\ud2b8\ub4e0 \ud658\uc601\uc774\uc5d0\uc694.</p>"},{"location":"posts/","title":"\uae00","text":"<p>\uc2dc\uac04\uc21c\uc73c\ub85c \uc815\ub9ac\ud55c \uae00 \ubaa9\ub85d\uc785\ub2c8\ub2e4. \uc0c8 \uae00\uc774 \uc62c\ub77c\uc624\uba74 \uc774 \ud398\uc774\uc9c0 \ub9e8 \uc704\uc5d0 \ucd94\uac00\ub429\ub2c8\ub2e4.</p>"},{"location":"posts/#2026-5","title":"2026\ub144 5\uc6d4","text":"<ul> <li>\ud658\uc601\ud569\ub2c8\ub2e4 \u2014 \uc0ac\uc774\ud2b8\ub97c \uc5f4\uba70 \uc801\uc740 \uccab \uae00 (2026-05-26)</li> <li>\ud53c\ub4dc\ubc31 \uc0ac\uc6a9\ubc95 \u2014 \ubcf8\ubb38\uc5d0 \uba54\ubaa8\ub97c \ub0a8\uae30\ub294 \uac00\ubcbc\uc6b4 \uc18c\uac1c (2026-05-26)</li> </ul> <p>\ub354 \uc790\uc138\ud55c \ud53c\ub4dc\ubc31 \uc0ac\uc6a9\ubc95\uc740 \ud53c\ub4dc\ubc31 \uc548\ub0b4 \ud398\uc774\uc9c0\ub97c \ucc38\uace0\ud574 \uc8fc\uc138\uc694.</p>"},{"location":"posts/2026-05-26-how-to-feedback/","title":"\ud53c\ub4dc\ubc31 \uc0ac\uc6a9\ubc95","text":"<p>2026\ub144 5\uc6d4 26\uc77c</p> <p>\ubcf8\uaca9\uc801\uc778 \uc548\ub0b4\ub294 \ud53c\ub4dc\ubc31 \uc548\ub0b4 \ud398\uc774\uc9c0\uc5d0 \uc815\ub9ac\ud574 \ub450\uc5c8\uc9c0\ub9cc, \uc5ec\uae30\uc11c\ub294 \uc815\ub9d0 \uac00\ubccd\uac8c\ub9cc \uc6b4\uc744 \ub5bc\uc5b4 \ub458\uac8c\uc694. \ubcf8\ubb38 \uc5b4\ub514\ub4e0 \ub9c8\uc6b0\uc2a4\ub85c \ub4dc\ub798\uadf8\ud558\uba74 \uc791\uc740 \ub3c4\uad6c\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uac70\uae30\uc5d0 \uc9e7\uac8c \ud55c \uc904, \ud639\uc740 \uae38\uac8c \ud55c \ubb38\ub2e8\uc744 \uc801\uc73c\uba74 \uadf8 \uc790\ub9ac\uc5d0 \uba54\ubaa8\uac00 \ubd99\uc2b5\ub2c8\ub2e4. \ubcc4\ub2e4\ub978 \ud68c\uc6d0\uac00\uc785 \uc808\ucc28\ub294 \uc5c6\uace0, \uba54\ubaa8\ub97c \ucc98\uc74c \ub0a8\uae30\ub294 \uc21c\uac04\uc5d0\ub9cc \uac04\ub2e8\ud55c \ub85c\uadf8\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.</p> <p>\ub0a8\uae38 \uc218 \uc788\ub294 \uba54\ubaa8\ub294 \ub450 \uac00\uc9c0 \uacb0\uc774\uc5d0\uc694. \ud558\ub098\ub294 \ub2e4\ub978 \ub3c5\uc790\uc5d0\uac8c\ub3c4 \ubcf4\uc774\ub294 \uacf5\uac1c \uba54\ubaa8\uc774\uace0, \ub2e4\ub978 \ud558\ub098\ub294 \ub098\ub9cc \ubcf4\ub294 \ube44\uacf5\uac1c \ud558\uc774\ub77c\uc774\ud2b8\uc785\ub2c8\ub2e4. \ucc98\uc74c\uc5d0\ub294 \uacf5\uac1c \ucabd\uc774 \ubd80\ub2f4\uc2a4\ub7ec\uc6b8 \uc218 \uc788\ub294\ub370, \ube44\uacf5\uac1c \ud558\uc774\ub77c\uc774\ud2b8\ub85c \uc790\uae30\ub9cc\uc758 \ub3c5\uc11c \ud754\uc801\uc744 \ub0a8\uae30\ub294 \uc6a9\ub3c4\ub85c \uc368\ub3c4 \ucda9\ubd84\ud788 \uc7ac\ubbf8\uc788\uc2b5\ub2c8\ub2e4.</p> <p>\ubd84\uc704\uae30\uc5d0 \ub300\ud55c \uc9e7\uc740 \ubd80\ud0c1 \ud558\ub098\ub9cc \ub4dc\ub9b4\uac8c\uc694. \uae00\uc5d0 \ub300\ud55c \ubc18\ubc15\uc774\ub4e0 \ub3d9\uc758\ub4e0, \uac19\uc740 \ubb38\ub2e8\uc744 \ud568\uaed8 \uc77d\ub294 \ub2e4\ub978 \ub3c5\uc790\uac00 \uc788\ub2e4\uace0 \uc0c1\uc0c1\ud558\uace0 \ud55c \ud638\ud761 \uace8\ub77c \uc8fc\uc2dc\uba74 \uc88b\uaca0\uc2b5\ub2c8\ub2e4. \uaca9\ub82c\ud55c \ud1a0\ub860\ub3c4 \ud658\uc601\uc774\uc9c0\ub9cc, \ub204\uad70\uac00\uc758 \ud754\uc801\uc744 \uae4e\uc544\ub0b4\ub9ac\ub294 \ubc29\uc2dd\uc758 \ucf54\uba58\ud2b8\ub294 \uac00\uae09\uc801 \ud53c\ud574 \uc8fc\uc138\uc694. \uadf8\uac83\ub9cc \uc9c0\ucf1c\uc9c4\ub2e4\uba74 \uc5b4\ub5a4 \uacb0\uc758 \ubc18\uc751\uc774\ub4e0 \ud658\uc601\uc785\ub2c8\ub2e4.</p>"},{"location":"posts/2026-05-26-welcome/","title":"\ud658\uc601\ud569\ub2c8\ub2e4","text":"<p>2026\ub144 5\uc6d4 26\uc77c</p> <p>\uc624\ub7ab\ub3d9\uc548 \ubbf8\ub8e8\uae30\ub9cc \ud558\ub358 \uc77c\uc744 \ub4dc\ub514\uc5b4 \uaebc\ub0b4\ub4ed\ub2c8\ub2e4. \ud3c9\uc18c\uc5d0 \uba54\ubaa8\uc7a5\uc5d0\ub9cc \uc801\uc5b4 \ub450\ub358 \uc9e7\uc740 \uae00\ub4e4\uacfc, \uc5b4\ub518\uac00\uc5d0 \ud480\uc5b4\ub193\uace0 \uc2f6\uc5c8\ub358 \uae34 \uc774\uc57c\uae30\ub4e4\uc744 \ud55c \uc790\ub9ac\uc5d0 \ubaa8\uc544 \ubcf4\ub824\uace0\uc694. \uac70\ucc3d\ud55c \ucd9c\ud310 \uacc4\ud68d\uc774 \uc788\ub294 \uac83\uc740 \uc544\ub2c8\uace0, \uadf8\ub0e5 \uae00\uc774 \ub204\uad70\uac00\uc5d0\uac8c \uac00\ub2ff\ub294 \uac10\uac01\uc744 \ub2e4\uc2dc \ud68c\ubcf5\ud574 \ubcf4\uace0 \uc2f6\uc5c8\uc2b5\ub2c8\ub2e4.</p> <p>\uc774 \uc0ac\uc774\ud2b8\uc758 \uac00\uc7a5 \ud070 \ud2b9\uc9d5\uc740 \ub3c5\uc790\uac00 \ubcf8\ubb38\uc5d0 \uc9c1\uc811 \uba54\ubaa8\ub97c \ub0a8\uae38 \uc218 \uc788\ub2e4\ub294 \uc810\uc785\ub2c8\ub2e4. \ubcf4\ud1b5\uc758 \ube14\ub85c\uadf8\ub294 \uae00 \uc544\ub798\uc5d0 \ub313\uae00\ucc3d \ud558\ub098\uac00 \ub2ec\ub824 \uc788\uace0, \uc758\uacac\uc744 \ub0a8\uae30\ub824\uba74 \uadf8 \ud55c \uce78 \uc548\uc5d0 \ubaa8\ub4e0 \uc0dd\uac01\uc744 \uc555\ucd95\ud574\uc57c \ud569\ub2c8\ub2e4. \uadf8\ub7f0\ub370 \uc0ac\uc2e4 \uc6b0\ub9ac\uac00 \uae00\uc744 \uc77d\ub2e4 \ubcf4\uba74, \uc5b4\ub5a4 \ubb38\uc7a5\uc5d0\uc11c\ub294 \ud658\ud638\ud558\uace0 \uc5b4\ub5a4 \ubb38\uc7a5\uc5d0\uc11c\ub294 \uac38\uc6b0\ub6b1\ud558\uace0 \ub610 \uc5b4\ub5a4 \ubb38\uc7a5\uc5d0\uc11c\ub294 \ub2e4\ub978 \uae30\uc5b5\uc774 \ub5a0\uc624\ub974\uc796\uc544\uc694. \uadf8 \uac10\uac01\uc774 \ud769\uc5b4\uc9c0\uae30 \uc804\uc5d0 \ubc14\ub85c \uadf8 \ubb38\uc7a5 \uc606\uc5d0 \ud754\uc801\uc744 \ub0a8\uae38 \uc218 \uc788\uc73c\uba74 \uc88b\uaca0\ub2e4\uace0 \uc0dd\uac01\ud588\uc2b5\ub2c8\ub2e4.</p> <p>\uadf8\ub798\uc11c \uc774 \uc0ac\uc774\ud2b8\ub294 \ubb38\ub2e8 \ub2e8\uc704, \ubb38\uc7a5 \ub2e8\uc704\ub85c \uba54\ubaa8\ub97c \ubd99\uc77c \uc218 \uc788\uac8c \ub9cc\ub4e4\uc5c8\uc5b4\uc694. \ubcf8\ubb38 \uc5b4\ub514\ub4e0 \ub9c8\uc6b0\uc2a4\ub85c \ub4dc\ub798\uadf8\ud558\uba74 \uc791\uc740 \ubc84\ud2bc\uc774 \ub098\ud0c0\ub098\uace0, \uadf8 \uc790\ub9ac\uc5d0 \uc9e7\uc740 \ucf54\uba58\ud2b8\ub97c \ub0a8\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \ub3c5\uc790\uc758 \uba54\ubaa8\ub3c4 \uac19\uc740 \uc790\ub9ac\uc5d0 \ud568\uaed8 \ubcf4\uc785\ub2c8\ub2e4. \uac19\uc740 \ubb38\ub2e8\uc5d0\uc11c \uc0ac\ub78c\ub4e4\uc774 \uc5b4\ub5a4 \uacb0\uc758 \ubc18\uc751\uc744 \ubcf4\uc600\ub294\uc9c0 \ud55c\ub208\uc5d0 \ub4e4\uc5b4\uc624\ub294, \uc77c\uc885\uc758 \uc791\uc740 \uacf5\ub3d9 \ub3c5\uc11c\uc2e4 \uac19\uc740 \uacbd\ud5d8\uc744 \ub9cc\ub4e4\uace0 \uc2f6\uc5c8\uc2b5\ub2c8\ub2e4.</p> <p>\ubb3c\ub860 \uc774\ub7f0 \uae30\ub2a5\uc774 \ubaa8\ub4e0 \uae00\uc5d0 \uc5b4\uc6b8\ub9ac\ub294 \uac74 \uc544\ub2d9\ub2c8\ub2e4. \uc5b4\ub5a4 \uae00\uc740 \uadf8\ub0e5 \uc870\uc6a9\ud788 \uc77d\ud788\ub294 \ud3b8\uc774 \ub354 \uc88b\uace0, \uc5b4\ub5a4 \uae00\uc740 \uc2dc\ub04c\ubc85\uc801\ud558\uac8c \uc77d\ud788\ub294 \ud3b8\uc774 \ub354 \uc88b\uc2b5\ub2c8\ub2e4. \uadf8 \ube44\uc728\uc740 \uae00\uc744 \uc4f0\uba74\uc11c \uc870\uae08\uc529 \ucc3e\uc544\uac00 \ubcf4\ub824 \ud569\ub2c8\ub2e4. \ub108\ubb34 \ubd80\ub2f4 \uac16\uc9c0 \ub9c8\uc2dc\uace0, \ub9c8\uc74c\uc774 \ub3d9\ud560 \ub54c\ub9cc \uac00\ubccd\uac8c \ud754\uc801\uc744 \ub0a8\uaca8 \uc8fc\uc138\uc694. \uadf8 \ud754\uc801\ub4e4\uc774 \ubaa8\uc5ec\uc11c \uc5b4\ub5a4 \ubaa8\uc591\uc774 \ub420\uc9c0, \uc800\ub3c4 \uad81\uae08\ud558\uba74\uc11c \uc57d\uac04 \ub5a8\ub9ac\ub294 \ub9c8\uc74c\uc73c\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4.</p> <p>\uc55e\uc73c\ub85c \uc798 \ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4.</p>"}]}